PORT=3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DB_HOST=localhost
DB_PORT=5435
DB_USER=accounting
DB_PASSWORD=accounting_dev
DB_NAME=accounting_nest
DB_MIGRATIONS_RUN=false
DB_SSL=false
JWT_SIGNING_KEY=CHANGE-ME-WITH-A-LONG-SECRET-OF-AT-LEAST-32-CHARACTERS
JWT_ISSUER=accounting-platform
JWT_AUDIENCE=accounting-platform-api
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=accounting-documents
OBJECT_STORAGE_PROVIDER=minio
# Azure production example (uses DefaultAzureCredential / managed identity):
# OBJECT_STORAGE_PROVIDER=azure
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=accounting-documents

# Private NuExtract worker (disabled by default for local development).
DOCUMENT_EXTRACTION_ENABLED=false
NUEXTRACT_SERVICE_URL=https://fiscora-nuextract-xxxxxxxxxx-ew.a.run.app
NUEXTRACT_TIMEOUT_MS=600000
DOCUMENT_EXTRACTION_MAX_ATTEMPTS=4
DOCUMENT_EXTRACTION_LEASE_MINUTES=15
# Azure managed identity -> Google Workload Identity Federation (no static key).
AZURE_GCP_WIF_APP_ID_URI=api://TENANT_ID/fiscora-google-wif
GCP_WIF_PROVIDER_AUDIENCE=//iam.googleapis.com/projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/fiscora-azure/providers/azure-container-apps
GCP_WIF_SERVICE_ACCOUNT=fiscora-azure-api@fiscora-ai.iam.gserviceaccount.com

# Permission-scoped dossier assistant (disabled by default).
AI_ASSISTANT_ENABLED=false
GCP_PROJECT_ID=fiscora-ai
VERTEX_AI_LOCATION=global
VERTEX_AI_CHAT_MODEL=gemini-2.5-flash
VERTEX_AI_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_AI_EMBEDDING_DIMENSIONS=768
VERTEX_AI_TIMEOUT_MS=60000
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
APP_PUBLIC_URL=http://127.0.0.1:5173
INVITATION_EXPOSE_LINK=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fiscora <invitations@fiscora.local>

# Brevo production example:
# INVITATION_EXPOSE_LINK=false
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<brevo-smtp-login>
# SMTP_PASSWORD=<brevo-smtp-key>
# SMTP_FROM=Fiscora <invitations@fiscora.me>
BACKUP_ENABLED=false
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-FOR-SHARED-ENVIRONMENTS
METRICS_TOKEN=
