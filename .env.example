PORT=3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DB_HOST=localhost
DB_PORT=5435
DB_USER=accounting
DB_PASSWORD=accounting_dev
DB_NAME=accounting_nest
DB_MIGRATIONS_RUN=false
DB_SSL=false
JWT_SIGNING_KEY=CHANGE-ME-WITH-A-LONG-SECRET-OF-AT-LEAST-32-CHARACTERS
MFA_ENCRYPTION_KEY=CHANGE-ME-WITH-A-SEPARATE-RANDOM-SECRET-OF-AT-LEAST-32-CHARACTERS
JWT_ISSUER=accounting-platform
JWT_AUDIENCE=accounting-platform-api
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=accounting-documents
OBJECT_STORAGE_PROVIDER=minio
# Azure production example (uses DefaultAzureCredential / managed identity):
# OBJECT_STORAGE_PROVIDER=azure
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=accounting-documents

# Private Qwen3.5 extraction worker (disabled by default for local development).
DOCUMENT_EXTRACTION_ENABLED=false
DOCUMENT_EXTRACTION_SERVICE_URL=https://fiscora-extractor-xxxxxxxxxx-ew.a.run.app
DOCUMENT_EXTRACTION_MODEL=Qwen/Qwen3.5-4B
DOCUMENT_EXTRACTION_AUTO_QUEUE=true
DOCUMENT_EXTRACTION_TIMEOUT_MS=600000
DOCUMENT_EXTRACTION_MAX_TOKENS=8000
DOCUMENT_EXTRACTION_MAX_ATTEMPTS=4
DOCUMENT_EXTRACTION_LEASE_MINUTES=30
DOCUMENT_EXTRACTION_WORKER_CONCURRENCY=4
DOCUMENT_EXTRACTION_QWEN_CONCURRENCY=4
DOCUMENT_EXTRACTION_OCR_BATCH_PAGES=4
DOCUMENT_EXTRACTION_OCR_BATCH_MAX_CHARS=28000
PADDLE_OCR_SERVICE_URL=https://fiscora-paddleocr-xxxxxxxxxx-ew.a.run.app
PADDLE_OCR_TIMEOUT_MS=900000
# Azure managed identity -> Google Workload Identity Federation (no static key).
AZURE_GCP_WIF_APP_ID_URI=api://TENANT_ID/fiscora-google-wif
GCP_WIF_PROVIDER_AUDIENCE=//iam.googleapis.com/projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/fiscora-azure/providers/azure-container-apps
GCP_WIF_SERVICE_ACCOUNT=fiscora-azure-api@fiscora-ai.iam.gserviceaccount.com

# Permission-scoped dossier assistant (disabled by default).
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_AUTO_INDEX_ENABLED=true
AI_ASSISTANT_INDEX_MAX_ATTEMPTS=5
AI_ASSISTANT_INDEX_LEASE_MINUTES=10
GCP_PROJECT_ID=fiscora-ai
VERTEX_AI_LOCATION=global
VERTEX_AI_CHAT_MODEL=gemini-2.5-flash
VERTEX_AI_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_AI_EMBEDDING_DIMENSIONS=768
AI_ASSISTANT_MAX_VECTOR_DISTANCE=0.8
VERTEX_AI_TIMEOUT_MS=60000
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
APP_PUBLIC_URL=http://127.0.0.1:5173
INVITATION_EXPOSE_LINK=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fiscora <invitations@fiscora.local>

# Brevo production example:
# INVITATION_EXPOSE_LINK=false
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<brevo-smtp-login>
# SMTP_PASSWORD=<brevo-smtp-key>
# SMTP_FROM=Fiscora <invitations@fiscora.me>
BACKUP_ENABLED=false
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-FOR-SHARED-ENVIRONMENTS
METRICS_TOKEN=
# Inbound accounting documents (Brevo Inbound Parse)
EMAIL_INGESTION_DOMAIN=inbox.fiscora.me
# Generate a long random value and use it in the Brevo webhook URL.
INBOUND_EMAIL_WEBHOOK_SECRET=
# Brevo REST API key (not the SMTP key); used only to download attachments.
BREVO_API_KEY=
EMAIL_INGESTION_MAX_ATTACHMENT_BYTES=20971520
